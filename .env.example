# Optional: OpenAI API Key for live AI Chatbot responses (defaults to built-in smart portfolio responses if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Resend API Key for sending emails via the contact form (logs to console in dev if omitted)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
CONTACT_EMAIL=hello@example.com